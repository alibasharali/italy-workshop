{
  // PR-miljø i GitHub Codespaces: hele stacken med mock-innlogging (ingen Zitadel).
  // Åpnes fra «Open in Codespaces»-knappen i PR-en. Frontend åpnes automatisk på port 3000.
  "name": "Trønder Leikan (PR-miljø)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "containerEnv": {
    "Auth__Mode": "mock",
    "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
    "DOTNET_DASHBOARD_UNSECURED_ALLOW_ANONYMOUS": "true"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-stack.sh",
  "forwardPorts": [3000, 15104],
  "portsAttributes": {
    "3000": { "label": "Trønder Leikan", "onAutoForward": "openBrowser" },
    "15104": { "label": "Aspire-dashboard", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "anthropic.claude-code"]
    }
  }
}
