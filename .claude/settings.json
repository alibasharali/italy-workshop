{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(src/TronderLeikan.AppHost/zitadel-bootstrap/**)",
      "Read(~/.microsoft/usersecrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(src/TronderLeikan.AppHost/zitadel-bootstrap/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secrets.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-checks.sh",
            "timeout": 600,
            "statusMessage": "Kjører bygg og raske tester før agenten er ferdig..."
          }
        ]
      }
    ]
  }
}
